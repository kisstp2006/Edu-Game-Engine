{
  "FormatVersion": 1,
  "Title": "Project Settings",
  "Categories": [
    {
      "Id": "application",
      "Label": "Application",
      "Settings": [
        {
          "Id": "application.display_name",
          "Label": "Display Name",
          "Description": "The name shown for the running project.",
          "Type": "string",
          "Default": "Edu Engine"
        },
        {
          "Id": "application.organization",
          "Label": "Organization",
          "Description": "The studio or publisher name stored with the project.",
          "Type": "string",
          "Default": "UPC CITM"
        },
        {
          "Id": "runtime.max_framerate",
          "Label": "Maximum Framerate",
          "Description": "Zero disables the software framerate limit.",
          "Type": "integer",
          "Default": 0,
          "Min": 0,
          "Max": 360,
          "Step": 1
        }
      ]
    },
    {
      "Id": "rendering",
      "Label": "Rendering",
      "Settings": [
        {
          "Id": "rendering.vertical_sync",
          "Label": "Vertical Sync",
          "Description": "Synchronize presentation with the display refresh rate.",
          "Type": "boolean",
          "Default": false
        }
      ]
    },
    {
      "Id": "scripting",
      "Label": "Scripting",
      "Settings": [
        {
          "Id": "scripting.hot_reload",
          "Label": "Hot Reload",
          "Description": "Compile changed AngelScript files and atomically replace the running script module.",
          "Type": "boolean",
          "Default": true
        }
      ]
    },
